ymmsl_version: v0.1
model:
  name: test_model
  components:
    source_component:
      implementation: source_component
      ports:
        o_i: [equilibrium_out, pf_active_out]
    recorder:
      implementation: recorder
      ports:
        s: [equilibrium_in, pf_active_in]
  conduits:
    source_component.equilibrium_out: recorder.equilibrium_in
    source_component.pf_active_out: recorder.pf_active_in
settings:
  source_component.source_uri: imas:hdf5?path=/path/to/your/imasdb
  recorder.config: imas_muscle3/visualization/examples/pds/pds.py
  recorder.md: >-
    wall=imas:hdf5?path=/path/to/your/imasdb
    pf_active=imas:hdf5?path=/path/to/your/imasdb
implementations:
  recorder:
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component
  source_component:
    executable: python
    args: -u -m imas_muscle3.actors.source_component
resources:
  source_component:
    threads: 1
  recorder:
    threads: 1
