ymmsl_version: v0.1
model:
  name: my_recording
  components:
    source_component:
      implementation: source_component
      ports:
        o_i: [equilibrium_out]
    rec:
      implementation: recorder
      ports:
        s: [equilibrium_in]
  conduits:
    source_component.equilibrium_out: rec.equilibrium_in
settings:
  source_component.source_uri: imas:hdf5?path=/path/to/your/imasdb
  rec.config: imas_muscle3/visualization/examples/simple_1d_plot/simple_1d_plot.py
implementations:
  recorder:
    executable: python
    args: -u -m imas_muscle3.actors.recorder_component
  source_component:
    executable: python
    args: -u -m imas_muscle3.actors.source_component
resources:
  source_component:
    threads: 1
  rec:
    threads: 1
